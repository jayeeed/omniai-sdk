# ==============================================================================
# OmniAI Python SDK Environment Configuration Example
# ==============================================================================

# Your OmniAI Platform API Key (obtained from your OmniAI Dashboard)
OMNIAI_API_KEY=sk-or-v1-your-api-key-here

# Optional: Custom OmniAI Gateway Base URL (defaults to production if omitted)
OMNIAI_BASE_URL=https://omniai.go-agents.app

# Optional: Upstream Direct LLM Provider Keys (for standalone local RouterEngine execution)
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
